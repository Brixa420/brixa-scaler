# ═══════════════════════════════════════════════════════════════
# BrixaScaler Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ═ SECURITY (REQUIRED for production)
# ═══════════════════════════════════════════════════════════════
API_KEY=your_api_key_here

# ═ DEMO MODE (default: true)
# ═══════════════════════════════════════════════════════════════
DEMO_MODE=true

# ═ SETTLEMENT (required for real transactions)
# ═══════════════════════════════════════════════════════════════
SETTLEMENT_RPC_URL=
SETTLEMENT_PRIVATE_KEY=
SETTLEMENT_CHAIN_ID=1

# ═ RATE LIMITING
# ═══════════════════════════════════════════════════════════════
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20
MAX_REQUEST_SIZE=1048576

# ═ GAS LIMITS
# ═══════════════════════════════════════════════════════════════
MAX_GAS_PRICE_GWEI=100
MAX_TX_VALUE=1000000000000000000
MAX_TX_DATA_SIZE=1024

# ═ CORS
# ═══════════════════════════════════════════════════════════════
CORS_ORIGINS=

# ═ MULTI-SIG (for high-value transactions)
# ═══════════════════════════════════════════════════════════════
MULTISIG_ENABLED=false
MULTISIG_THRESHOLD=2
MULTISIG_APPROVERS=
MULTISIG_HIGH_VALUE_THRESHOLD=10000000000000000000

# ═ HTTPS
# ═══════════════════════════════════════════════════════════════
REDIRECT_HTTP_TO_HTTPS=false
